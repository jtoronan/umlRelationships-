#Activity 3
class Warrior:
    def special_move(self):
        print("Warrior swings a mighty sword!")


class Mage:
    def special_move(self):
        print("Mage casts a powerful spell!")


class Archer:
    def special_move(self):
        print("Archer shoots a precise arrow!")


def perform_move(character):
    character.special_move()


warrior = Warrior()
mage = Mage()
archer = Archer()

characters = [warrior, mage, archer]

for character in characters:
    perform_move(character)

#Activity 4
class HealthPotion:
    def use(self):
        print("You regain 50 HP!")


class ManaPotion:
    def use(self):
        print("You restore 30 MP!")


class SpeedBoost:
    def use(self):
        print("Your speed increases for 10 seconds!")


def apply_item(item):
    item.use()


health_potion = HealthPotion()
mana_potion = ManaPotion()
speed_boost = SpeedBoost()

potions = [health_potion, mana_potion, speed_boost]

for potion in potions:
    apply_item(potion)


